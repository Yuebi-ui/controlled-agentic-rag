# Controlled Agentic RAG service configuration (copy to .env locally).
# No model checkpoint is bundled with this repository.
ANSWER_MODEL_VARIANT=dpo
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
QWEN3_DPO_MODEL_NAME=qwen3-8b-dpo
QWEN3_SFT_MODEL_NAME=qwen3-8b-sft
QWEN3_BASE_MODEL_NAME=qwen3-8b-base
QWEN3_OUTPUT_MODE=structured_outputs
# Optional variant-specific serving endpoints:
# QWEN3_DPO_BASE_URL=http://127.0.0.1:8000/v1
# QWEN3_SFT_BASE_URL=http://127.0.0.1:8002/v1

# Optional real-backend settings; integration is application-specific.
BGE_RERANKER_MODEL_DIR=/secure/local/checkpoint
ROUTER_ARTIFACT_PATH=/secure/local/artifacts/router.json
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=manual_kb
INDEX_MANIFEST_PATH=/secure/local/manifest.json
# Explicitly opt into a synthetic demo API. Never deploy as a real service.
# RAG_MODE=demo
