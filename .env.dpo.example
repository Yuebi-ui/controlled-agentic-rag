# Controlled Agentic RAG final AnswerModel (future model service)
# Copy these lines into .env once model serving is available.
ANSWER_MODEL_VARIANT=dpo
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
QWEN3_DPO_MODEL_NAME=qwen3-8b-dpo
QWEN3_SFT_MODEL_NAME=qwen3-8b-sft
# Optional dedicated vLLM URLs:
# QWEN3_DPO_BASE_URL=http://127.0.0.1:8000/v1
# QWEN3_SFT_BASE_URL=http://127.0.0.1:8002/v1
# vLLM newer: structured_outputs; older 0.9: guided_json
QWEN3_OUTPUT_MODE=structured_outputs

# Optional pretrained Base comparison; never selected without explicit variant=base.
QWEN3_BASE_MODEL_NAME=qwen3-8b-base
QWEN3_BASE_BASE_URL=http://127.0.0.1:8002/v1
